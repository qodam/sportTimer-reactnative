{
  "expo": {
    "name": "PushPause",
    "slug": "pushpause",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pushpause",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/icon_ios.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#15171C",
        "foregroundImage": "./assets/icon_android.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.codinghub.pushpause"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon_ios.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15171C",
          "image": "./assets/splash.png",
          "imageWidth": 160
        }
      ],
      "expo-image",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#15171C"
  }
}
