{
  "expo": {
    "name": "PushPause",
    "slug": "pushpause",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pushpause",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/icon_ios.png",
      "bundleIdentifier": "com.codinghub.pushpause",
      "appleTeamId": "TON_TEAM_ID",
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#15171C",
        "foregroundImage": "./assets/icon_android.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.codinghub.pushpause"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon_ios.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15171C",
          "image": "./assets/splash.png",
          "imageWidth": 160
        }
      ],
      "expo-image",
      "expo-localization",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#15171C",
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.codinghub.pushpause.widget",
                  "targetName": "PushPauseActivity"
                }
              ]
            }
          }
        },
        "projectId": "444e4abf-3f01-47ff-a30a-1aa2204f9ba6"
      }
    }
  }
}
